.root {
    padding: 10px;
    min-width: 400px;
    min-height: 500px;
}

.title {
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 10px;
    padding: 8px;
    background-color: rgba(0, 0, 0, 0.2);
    -unity-text-align: middle-center;
}

.section {
    margin-bottom: 10px;
    padding: 8px;
    background-color: rgba(0, 0, 0, 0.1);
    border-radius: 4px;
}

.section-title {
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.preset-row {
    flex-direction: row;
    margin-bottom: 8px;
    align-items: center;
    flex-shrink: 0;
}

.preset-dropdown {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 80px;
    margin-right: 4px;
}

.preset-btn {
    width: 36px;
    min-width: 36px;
    height: 22px;
    font-size: 11px;
    margin-left: 2px;
    flex-shrink: 0;
}

.save-preset-btn {
    background-color: rgba(50, 120, 200, 0.4);
}

.save-preset-btn:hover {
    background-color: rgba(50, 120, 200, 0.6);
}

.delete-preset-btn {
    background-color: rgba(200, 80, 80, 0.4);
}

.delete-preset-btn:hover {
    background-color: rgba(200, 80, 80, 0.6);
}

.folder-section {
    margin-bottom: 8px;
    padding: 6px;
    background-color: rgba(0, 0, 0, 0.15);
    border-radius: 3px;
}

.folder-label {
    font-size: 11px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.source-label {
    color: rgba(100, 180, 255, 1);
}

.target-label {
    color: rgba(255, 180, 100, 1);
}

.folder-field {
    flex-grow: 1;
}

.action-button {
    height: 28px;
    background-color: rgba(0, 100, 200, 0.3);
}

.action-button:hover {
    background-color: rgba(0, 100, 200, 0.5);
}

.result-section {
    flex-grow: 1;
}

.dependency-list {
    min-height: 200px;
    max-height: 400px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.5);
    background-color: rgba(0, 0, 0, 0.2);
    padding: 4px;
}

.dependency-item {
    padding: 8px;
    margin-bottom: 6px;
    background-color: rgba(60, 60, 60, 0.5);
    border-radius: 4px;
    cursor: link;
}

.dependency-item:hover {
    background-color: rgba(80, 120, 180, 0.5);
}

.dependency-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.dependency-name {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgba(100, 180, 255, 1);
    flex-grow: 1;
}

.dependency-type {
    font-size: 10px;
    color: rgba(150, 150, 150, 1);
    margin-left: 6px;
}

.dependency-path {
    font-size: 10px;
    color: rgba(160, 160, 160, 1);
    margin-bottom: 4px;
}

.ref-container {
    padding-left: 10px;
    margin-top: 4px;
    border-left-width: 2px;
    border-left-color: rgba(255, 180, 100, 0.5);
}

.ref-item {
    margin-bottom: 4px;
    padding: 4px;
    background-color: rgba(0, 0, 0, 0.15);
    border-radius: 2px;
    cursor: link;
}

.ref-item:hover {
    background-color: rgba(255, 180, 100, 0.3);
}

.ref-header {
    flex-direction: row;
    align-items: center;
}

.ref-arrow {
    font-size: 10px;
    color: rgba(255, 180, 100, 1);
    margin-right: 4px;
}

.ref-target-name {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgba(255, 200, 150, 1);
}

.ref-target-type {
    font-size: 9px;
    color: rgba(180, 150, 120, 1);
    margin-left: 4px;
}

.ref-detail {
    font-size: 9px;
    color: rgba(140, 140, 140, 1);
    margin-top: 2px;
    padding-left: 14px;
}

.empty-label {
    font-size: 11px;
    color: rgba(150, 150, 150, 1);
    -unity-font-style: italic;
    padding: 10px;
    -unity-text-align: middle-center;
}

.status-label {
    font-size: 11px;
    color: rgba(180, 180, 180, 1);
    margin-top: 6px;
    padding: 4px;
}
