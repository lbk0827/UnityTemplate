<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <ui:VisualElement name="root" class="root">
        <ui:Label text="Nested Prefab Finder" class="title" />

        <ui:VisualElement name="current-prefab-section" class="section">
            <ui:Label name="current-prefab-label" text="No prefab opened" class="current-prefab-label" />
        </ui:VisualElement>

        <ui:VisualElement name="folder-section" class="section">
            <ui:Label text="Target Folders" class="section-title" />

            <ui:VisualElement name="preset-row" class="preset-row">
                <ui:DropdownField name="preset-dropdown" class="preset-dropdown" />
                <ui:Button name="save-preset-btn" text="Save" class="preset-btn save-preset-btn" />
                <ui:Button name="delete-preset-btn" text="Del" class="preset-btn delete-preset-btn" />
            </ui:VisualElement>

            <ui:VisualElement name="folder-list" class="folder-list" />
            <ui:Button name="add-folder-btn" text="+ Add Folder" class="add-folder-btn" />
        </ui:VisualElement>

        <ui:VisualElement name="control-section" class="section">
            <ui:Button name="refresh-btn" text="Refresh" class="action-button" />
        </ui:VisualElement>

        <ui:VisualElement name="result-section" class="section result-section">
            <ui:Label text="Found Nested Prefabs" class="section-title" />
            <ui:ScrollView name="prefab-list" class="prefab-list" />
        </ui:VisualElement>

        <ui:VisualElement name="resource-section" class="section result-section">
            <ui:Label text="Found Resource Assets" class="section-title" />
            <ui:ScrollView name="resource-list" class="prefab-list" />
        </ui:VisualElement>

        <ui:Label name="status-label" text="Open a prefab to search" class="status-label" />
    </ui:VisualElement>
</ui:UXML>
