* text=auto eol=lf

# Unity YAML — mergeable with UnityYAMLMerge
*.unity      merge=unityyamlmerge eol=lf
*.prefab     merge=unityyamlmerge eol=lf
*.asset      merge=unityyamlmerge eol=lf
*.mat        merge=unityyamlmerge eol=lf
*.anim       merge=unityyamlmerge eol=lf
*.controller merge=unityyamlmerge eol=lf
*.meta       eol=lf

# Binary
*.dll   binary
*.so    binary
*.a     binary
*.png   binary
*.jpg   binary
*.psd   binary
*.wav   binary
*.mp3   binary
*.ogg   binary
*.fbx   binary
*.ttf   binary
*.otf   binary
*.unitypackage binary
